---
// Search Modal Component (Dark Portfolio / Warm Paper Aesthetic)
---

<div
  id="search-modal"
  class="search-overlay"
  hidden
  aria-hidden="true"
  style="display: none !important;"
  role="dialog"
  aria-modal="true"
  aria-label="Search essays"
>
  <div class="search-backdrop" id="search-backdrop" aria-hidden="true"></div>
  <div class="search-dialog" id="search-dialog">
    <header class="search-header">
      <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="search-input"
        class="search-input"
        placeholder="Search 78+ essays, systems, code, art... (Esc to close)"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search essays"
      />
      <button type="button" id="search-close" class="search-close" aria-label="Close search (Esc)" title="Close search (Esc)">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <div id="search-meta-bar" class="search-meta-bar" hidden style="display: none;">
      <span id="search-count-text" class="search-count-text"></span>
      <span class="search-relevance-hint">Ranked by relevance</span>
    </div>

    <div id="search-results-container" class="search-results-container">
      <div id="search-empty" class="search-message">
        <div class="search-empty-title">Explore essays & technical notes</div>
        <p class="search-empty-sub">Search across titles, topics, code patterns, and writings.</p>
        <div class="search-chips-label">Popular topics:</div>
        <div class="search-chips">
          <button type="button" class="search-chip" data-search-chip="systems">systems</button>
          <button type="button" class="search-chip" data-search-chip="agents">agents</button>
          <button type="button" class="search-chip" data-search-chip="ai">ai</button>
          <button type="button" class="search-chip" data-search-chip="c++">c++</button>
          <button type="button" class="search-chip" data-search-chip="go">go</button>
          <button type="button" class="search-chip" data-search-chip="art">art</button>
          <button type="button" class="search-chip" data-search-chip="hackathons">hackathons</button>
          <button type="button" class="search-chip" data-search-chip="writing">writing</button>
        </div>
      </div>
      <ul id="search-results-list" class="search-results-list" role="listbox" hidden style="display: none;"></ul>
    </div>

    <footer class="search-footer">
      <div class="search-shortcuts">
        <span><kbd>↑</kbd> <kbd>↓</kbd> navigate</span>
        <span><kbd>↵</kbd> select</span>
        <span><kbd>ESC</kbd> close</span>
      </div>
    </footer>
  </div>
</div>

<script>
  import Fuse from "fuse.js";

  interface SearchItem {
    id: string;
    title: string;
    description: string;
    tags: string[];
    categories: string[];
    lane?: string;
    date: string;
    content?: string;
  }

  let searchData: SearchItem[] | null = null;
  let fuseInstance: Fuse<SearchItem> | null = null;
  let activeIndex = -1;

  async function loadSearchData(): Promise<SearchItem[]> {
    if (searchData && fuseInstance) return searchData;
    try {
      const res = await fetch("/search.json");
      if (res.ok) {
        searchData = await res.json();
        if (searchData && Array.isArray(searchData)) {
          fuseInstance = new Fuse(searchData, {
            includeScore: true,
            includeMatches: true,
            threshold: 0.35,
            ignoreLocation: true,
            minMatchCharLength: 2,
            shouldSort: true,
            keys: [
              { name: "title", weight: 4 },
              { name: "tags", weight: 3 },
              { name: "categories", weight: 2 },
              { name: "description", weight: 2 },
              { name: "content", weight: 1 },
            ],
          });
        }
      }
    } catch (e) {
      console.error("Failed to load search index", e);
    }
    return searchData || [];
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function escapeRegex(str: string): string {
    return str.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  }

  function formatDate(dateStr: string): string {
    if (!dateStr) return "";
    const parts = dateStr.split("-");
    if (parts.length !== 3) return dateStr;
    const year = parts[0];
    const monthNum = parseInt(parts[1], 10) - 1;
    const day = parseInt(parts[2], 10);
    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    if (monthNum >= 0 && monthNum < 12) {
      return `${months[monthNum]} ${day}, ${year}`;
    }
    return dateStr;
  }

  function highlightWithMatches(
    text: string,
    indices?: readonly [number, number][],
    fallbackQuery?: string
  ): string {
    if (!text) return "";
    if (indices && indices.length > 0) {
      const sorted = [...indices].sort((a, b) => a[0] - b[0]);
      const merged: [number, number][] = [];
      for (const [start, end] of sorted) {
        if (merged.length === 0) {
          merged.push([start, end]);
        } else {
          const last = merged[merged.length - 1];
          if (start <= last[1] + 1) {
            last[1] = Math.max(last[1], end);
          } else {
            merged.push([start, end]);
          }
        }
      }

      let html = "";
      let lastIndex = 0;
      for (const [start, end] of merged) {
        if (start > lastIndex) {
          html += escapeHtml(text.slice(lastIndex, start));
        }
        html += `<mark class="search-highlight">${escapeHtml(text.slice(start, end + 1))}</mark>`;
        lastIndex = end + 1;
      }
      if (lastIndex < text.length) {
        html += escapeHtml(text.slice(lastIndex));
      }
      return html;
    }

    if (fallbackQuery) {
      const tokens = fallbackQuery
        .trim()
        .split(/\s+/)
        .filter((t) => t.length >= 2)
        .map(escapeRegex);
      if (tokens.length > 0) {
        const regex = new RegExp(`(${tokens.join("|")})`, "gi");
        const parts = text.split(regex);
        return parts
          .map((part) => {
            if (tokens.some((t) => new RegExp(`^${t}$`, "i").test(part))) {
              return `<mark class="search-highlight">${escapeHtml(part)}</mark>`;
            }
            return escapeHtml(part);
          })
          .join("");
      }
    }

    return escapeHtml(text);
  }

  function initSearch() {
    const modal = document.getElementById("search-modal");
    const dialog = document.getElementById("search-dialog");
    const backdrop = document.getElementById("search-backdrop");
    const input = document.getElementById("search-input") as HTMLInputElement | null;
    const closeBtn = document.getElementById("search-close");
    const list = document.getElementById("search-results-list");
    const emptyMsg = document.getElementById("search-empty");
    const metaBar = document.getElementById("search-meta-bar");
    const countText = document.getElementById("search-count-text");
    const searchTriggers = document.querySelectorAll("[data-open-search]");

    if (!modal || !input || !list || !emptyMsg) return;

    // Guarantee closed state on init
    modal.setAttribute("hidden", "");
    modal.classList.remove("is-open");
    modal.style.setProperty("display", "none", "important");
    modal.setAttribute("aria-hidden", "true");

    // Load search data eagerly in background
    loadSearchData();

    function openModal(initialQuery?: string) {
      modal.removeAttribute("hidden");
      modal.classList.add("is-open");
      modal.style.setProperty("display", "flex", "important");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      loadSearchData();

      setTimeout(() => {
        input.focus();
        if (initialQuery) {
          input.value = initialQuery;
          renderResults(initialQuery);
        } else {
          input.select();
        }
      }, 50);
    }

    function closeModal() {
      modal.setAttribute("hidden", "");
      modal.classList.remove("is-open");
      modal.style.setProperty("display", "none", "important");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      input.value = "";
      activeIndex = -1;

      if (metaBar) {
        metaBar.setAttribute("hidden", "");
        metaBar.style.display = "none";
      }

      list.setAttribute("hidden", "");
      list.style.display = "none";
      list.innerHTML = "";

      emptyMsg.removeAttribute("hidden");
      emptyMsg.style.display = "block";
      emptyMsg.innerHTML = `
        <div class="search-empty-title">Explore essays & technical notes</div>
        <p class="search-empty-sub">Search across titles, topics, code patterns, and writings.</p>
        <div class="search-chips-label">Popular topics:</div>
        <div class="search-chips">
          <button type="button" class="search-chip" data-search-chip="systems">systems</button>
          <button type="button" class="search-chip" data-search-chip="agents">agents</button>
          <button type="button" class="search-chip" data-search-chip="ai">ai</button>
          <button type="button" class="search-chip" data-search-chip="c++">c++</button>
          <button type="button" class="search-chip" data-search-chip="go">go</button>
          <button type="button" class="search-chip" data-search-chip="art">art</button>
          <button type="button" class="search-chip" data-search-chip="hackathons">hackathons</button>
          <button type="button" class="search-chip" data-search-chip="writing">writing</button>
        </div>
      `;
      wireChips();
    }

    function wireChips() {
      const chips = emptyMsg.querySelectorAll("[data-search-chip]");
      chips.forEach((chip) => {
        chip.addEventListener("click", (e) => {
          e.preventDefault();
          const topic = (chip as HTMLElement).dataset.searchChip || "";
          if (topic) {
            input.value = topic;
            input.focus();
            renderResults(topic);
          }
        });
      });
    }
    wireChips();

    // Triggers to open
    searchTriggers.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        openModal();
      });
    });

    // Close button click
    if (closeBtn) {
      closeBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeModal();
      });
    }

    // Close on backdrop click
    if (backdrop) {
      backdrop.addEventListener("click", (e) => {
        e.preventDefault();
        closeModal();
      });
    }

    modal.addEventListener("click", (e) => {
      if (dialog && !dialog.contains(e.target as Node)) {
        closeModal();
      }
    });

    // Keyboard shortcuts
    window.addEventListener("keydown", (e) => {
      const isVisible = modal.classList.contains("is-open") || !modal.hasAttribute("hidden") || modal.style.display === "flex";

      if (e.key === "Escape") {
        if (isVisible) {
          e.preventDefault();
          closeModal();
        }
      } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (isVisible) closeModal();
        else openModal();
      } else if (e.key === "/" && !isVisible) {
        const tag = (document.activeElement?.tagName || "").toLowerCase();
        if (tag !== "input" && tag !== "textarea") {
          e.preventDefault();
          openModal();
        }
      }
    });

    function renderResults(query: string) {
      const q = query.trim();

      if (!q) {
        if (metaBar) {
          metaBar.setAttribute("hidden", "");
          metaBar.style.display = "none";
        }
        list.setAttribute("hidden", "");
        list.style.display = "none";
        list.innerHTML = "";
        emptyMsg.removeAttribute("hidden");
        emptyMsg.style.display = "block";
        emptyMsg.innerHTML = `
          <div class="search-empty-title">Explore essays & technical notes</div>
          <p class="search-empty-sub">Search across titles, topics, code patterns, and writings.</p>
          <div class="search-chips-label">Popular topics:</div>
          <div class="search-chips">
            <button type="button" class="search-chip" data-search-chip="systems">systems</button>
            <button type="button" class="search-chip" data-search-chip="agents">agents</button>
            <button type="button" class="search-chip" data-search-chip="ai">ai</button>
            <button type="button" class="search-chip" data-search-chip="c++">c++</button>
            <button type="button" class="search-chip" data-search-chip="go">go</button>
            <button type="button" class="search-chip" data-search-chip="art">art</button>
            <button type="button" class="search-chip" data-search-chip="hackathons">hackathons</button>
            <button type="button" class="search-chip" data-search-chip="writing">writing</button>
          </div>
        `;
        wireChips();
        activeIndex = -1;
        return;
      }

      if (!fuseInstance && searchData) {
        fuseInstance = new Fuse(searchData, {
          includeScore: true,
          includeMatches: true,
          threshold: 0.35,
          ignoreLocation: true,
          minMatchCharLength: 2,
          shouldSort: true,
          keys: [
            { name: "title", weight: 4 },
            { name: "tags", weight: 3 },
            { name: "categories", weight: 2 },
            { name: "description", weight: 2 },
            { name: "content", weight: 1 },
          ],
        });
      }

      let searchResults: Array<{
        item: SearchItem;
        matches?: readonly Fuse.FuseResultMatch[];
        score?: number;
      }> = [];

      if (fuseInstance) {
        const rawResults = fuseInstance.search(q);
        searchResults = rawResults
          .filter((res) => (res.score ?? 1) <= 0.80)
          .slice(0, 10);
      } else if (searchData) {
        // Fallback if Fuse is still loading
        const lowerQ = q.toLowerCase();
        searchResults = searchData
          .filter(
            (item) =>
              item.title.toLowerCase().includes(lowerQ) ||
              item.description.toLowerCase().includes(lowerQ) ||
              item.tags.some((t) => t.toLowerCase().includes(lowerQ))
          )
          .slice(0, 10)
          .map((item) => ({ item }));
      }

      if (searchResults.length === 0) {
        if (metaBar) {
          metaBar.setAttribute("hidden", "");
          metaBar.style.display = "none";
        }
        list.setAttribute("hidden", "");
        list.style.display = "none";
        list.innerHTML = "";
        emptyMsg.removeAttribute("hidden");
        emptyMsg.style.display = "block";
        emptyMsg.innerHTML = `
          <div class="search-no-results">
            <div class="search-empty-title">No essays found for <span class="search-query-highlight">"${escapeHtml(q)}"</span></div>
            <p class="search-empty-sub">Try searching for broader keywords like <code>systems</code>, <code>ai</code>, <code>c++</code>, or <code>writing</code>.</p>
          </div>
        `;
        activeIndex = -1;
        return;
      }

      // Display results
      emptyMsg.setAttribute("hidden", "");
      emptyMsg.style.display = "none";

      if (metaBar && countText) {
        metaBar.removeAttribute("hidden");
        metaBar.style.display = "flex";
        const count = searchResults.length;
        countText.innerHTML = `Found <strong>${count}</strong> ${count === 1 ? "essay" : "essays"}`;
      }

      list.removeAttribute("hidden");
      list.style.display = "block";
      activeIndex = 0;

      list.innerHTML = searchResults
        .map(({ item, matches }, idx) => {
          const titleMatch = matches?.find((m) => m.key === "title");
          const descMatch = matches?.find((m) => m.key === "description");
          const contentMatch = matches?.find((m) => m.key === "content");
          const highlightedTitle = highlightWithMatches(item.title, titleMatch?.indices, q);

          // Smart snippet generation:
          // If match was in content and not in description (or description is empty), show excerpt around content match!
          let textForDesc = item.description || "";
          let descIndices = descMatch?.indices;

          if ((!textForDesc || (!descMatch && contentMatch)) && item.content) {
            if (contentMatch && contentMatch.indices && contentMatch.indices.length > 0) {
              const [startIdx] = contentMatch.indices[0];
              const snippetStart = Math.max(0, startIdx - 50);
              const snippetEnd = Math.min(item.content.length, startIdx + 110);
              const rawSnippet = item.content.slice(snippetStart, snippetEnd).trim();
              textForDesc = (snippetStart > 0 ? "..." : "") + rawSnippet + (snippetEnd < item.content.length ? "..." : "");
              descIndices = undefined; // Use token fallback highlighting on snippet
            } else if (!textForDesc) {
              textForDesc = item.content.slice(0, 140) + "...";
            }
          }
          const highlightedDesc = highlightWithMatches(textForDesc, descIndices, q);

          // Matched tags logic
          const lowerQ = q.toLowerCase();
          const matchedTags: string[] = [];
          const otherTags: string[] = [];

          (item.tags || []).forEach((t) => {
            if (t.toLowerCase().includes(lowerQ)) {
              matchedTags.push(t);
            } else {
              otherTags.push(t);
            }
          });

          // Show matched tags first, then other tags (up to 3 total)
          const displayTags = [...matchedTags, ...otherTags].slice(0, 3);
          const tagsHtml = displayTags
            .map((tag) => {
              const isMatched = matchedTags.includes(tag);
              const tagText = isMatched ? highlightWithMatches(tag, undefined, q) : escapeHtml(tag);
              return `<span class="search-result-tag ${isMatched ? "matched" : ""}">${tagText}</span>`;
            })
            .join("");

          const formattedDate = formatDate(item.date);
          const laneHtml = item.lane
            ? `<span class="search-result-lane">${escapeHtml(item.lane)}</span>`
            : item.categories && item.categories[0] && item.categories[0] !== "others"
            ? `<span class="search-result-lane">${escapeHtml(item.categories[0])}</span>`
            : "";

          return `
            <li role="option" id="search-opt-${idx}" aria-selected="${idx === 0}" class="search-result-item">
              <a href="/${escapeHtml(item.id)}" class="search-result-link ${idx === 0 ? "selected" : ""}" data-idx="${idx}">
                <div class="search-result-meta">
                  ${formattedDate ? `<span class="search-result-date">${formattedDate}</span>` : ""}
                  ${laneHtml}
                  ${tagsHtml ? `<div class="search-result-tags">${tagsHtml}</div>` : ""}
                </div>
                <div class="search-result-title">${highlightedTitle}</div>
                ${highlightedDesc ? `<div class="search-result-desc">${highlightedDesc}</div>` : ""}
              </a>
            </li>
          `;
        })
        .join("");

      // Wire mouse hover to seamlessly sync activeIndex
      const links = list.querySelectorAll<HTMLAnchorElement>(".search-result-link");
      links.forEach((link) => {
        link.addEventListener("mouseenter", () => {
          const idx = parseInt(link.dataset.idx || "0", 10);
          activeIndex = idx;
          updateSelection(links);
        });
      });
    }

    function updateSelection(links: NodeListOf<HTMLAnchorElement>) {
      links.forEach((link, idx) => {
        if (idx === activeIndex) {
          link.classList.add("selected");
          link.parentElement?.setAttribute("aria-selected", "true");
          link.scrollIntoView({ block: "nearest" });
        } else {
          link.classList.remove("selected");
          link.parentElement?.setAttribute("aria-selected", "false");
        }
      });
    }

    input.addEventListener("input", (e) => {
      renderResults((e.target as HTMLInputElement).value);
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        closeModal();
        return;
      }

      const links = list.querySelectorAll<HTMLAnchorElement>(".search-result-link");
      if (links.length === 0) return;

      if (e.key === "ArrowDown") {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % links.length;
        updateSelection(links);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + links.length) % links.length;
        updateSelection(links);
      } else if (e.key === "Enter") {
        e.preventDefault();
        if (activeIndex >= 0 && links[activeIndex]) {
          links[activeIndex].click();
        }
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSearch);
  } else {
    initSearch();
  }
  document.addEventListener("astro:page-load", initSearch);
</script>

<style>
  .search-overlay {
    display: none !important;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1rem, 5vh, 3.5rem) 1rem;
  }

  .search-overlay.is-open {
    display: flex !important;
  }

  .search-overlay[hidden],
  .search-overlay:not(.is-open) {
    display: none !important;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 4, 4, 0.85);
    backdrop-filter: blur(6px);
  }

  .search-dialog {
    position: relative;
    width: min(100%, 680px);
    max-height: 85vh;
    background: var(--paper-raised, #161616);
    border: 1px solid var(--rule, #303030);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 10;
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.25rem;
    border-bottom: 1px solid var(--rule, #2c2c2c);
    background: var(--paper, #0b0b0b);
  }

  .search-icon {
    color: var(--muted, #9b9792);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--sans);
    font-size: 1.05rem;
    color: var(--ink, #edebe5);
    outline: none;
  }

  .search-input::placeholder {
    color: var(--muted, #85817c);
    font-family: var(--sans);
    font-size: 0.95rem;
  }

  .search-close {
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    padding: 0.35rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted, #9b9792);
    border-radius: 4px;
    transition: color 0.15s, border-color 0.15s, background-color 0.15s;
    min-width: 34px;
    min-height: 34px;
  }

  .search-close:hover {
    color: var(--ink, #edebe5);
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--rule, #333);
  }

  .search-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.45rem 1.25rem;
    background: rgba(0, 0, 0, 0.35);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.76rem;
    color: var(--muted, #9b9792);
  }

  .search-count-text strong {
    color: var(--ink, #edebe5);
    font-weight: 600;
  }

  .search-relevance-hint {
    color: #706d69;
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .search-results-container {
    flex: 1;
    overflow-y: auto;
    max-height: 55vh;
    padding: 0.35rem 0;
  }

  .search-results-container::-webkit-scrollbar {
    width: 6px;
  }
  .search-results-container::-webkit-scrollbar-track {
    background: transparent;
  }
  .search-results-container::-webkit-scrollbar-thumb {
    background: #333;
    border-radius: 3px;
  }

  .search-message {
    padding: 2.25rem 1.5rem;
