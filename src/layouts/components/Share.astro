---
const { title, description } = Astro.props;
---

<ul style="list-style:none;padding:0;margin:0">
  <li style="display:inline;margin-right:1rem">
    <a aria-label="facebook share button" href={`https://facebook.com/sharer/sharer.php?u=${config.site.base_url}`} target="_blank" rel="noreferrer noopener">Facebook</a>
  </li>
  <li style="display:inline;margin-right:1rem">
    <a aria-label="twitter share button" href={`https://twitter.com/intent/tweet/?text=${title}&url=${config.site.base_url}`} target="_blank" rel="noreferrer noopener">Twitter</a>
  </li>
  <li style="display:inline;margin-right:1rem">
    <a aria-label="linkedin share button" href={`https://www.linkedin.com/shareArticle?mini=true&url=${config.site.base_url}&title=${title}&summary=${description}&source=${config.site.base_url}`} target="_blank" rel="noreferrer noopener">LinkedIn</a>
  </li>
  <li style="display:inline">
    <a aria-label="pinterest share button" href={`https://pinterest.com/pin/create/button/?url=${config.site.base_url}&media=&description=${description}`} target="_blank" rel="noreferrer noopener">Pinterest</a>
  </li>
</ul>
