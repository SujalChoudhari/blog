---
const { source, className } = Astro.props;

const {
  website,
  email,
  address,
  github,
  linkedin,
  twitter,
  youtube,
  rss,
} = source;
---

<ul class={className}>
  {website && (
    <li>
      <a
        aria-label="website"
        href={website}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >Web</a>
    </li>
  )}
  {email && (
    <li>
      <a
        aria-label="email"
        href={`mailto:${email}`}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >Email</a>
    </li>
  )}
  {address && (
    <li>
      <a
        aria-label="address"
        href={`https://maps.google.com/?q=${encodeURIComponent(address)}`}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >Address</a>
    </li>
  )}
  {github && (
    <li>
      <a
        aria-label="github"
        href={github}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >GitHub</a>
    </li>
  )}
  {linkedin && (
    <li>
      <a
        aria-label="linkedin"
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >LinkedIn</a>
    </li>
  )}
  {twitter && (
    <li>
      <a
        aria-label="twitter"
        href={twitter}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >Twitter</a>
    </li>
  )}
  {youtube && (
    <li>
      <a
        aria-label="youtube"
        href={youtube}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >YouTube</a>
    </li>
  )}
  {rss && (
    <li>
      <a
        aria-label="rss"
        href={rss}
        target="_blank"
        rel="noopener noreferrer nofollow"
      >RSS</a>
    </li>
  )}
</ul>

    )
  }
</ul>
