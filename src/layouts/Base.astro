---
import config from "@/config/config.json";
import Header from "@/layouts/partials/Header.astro";
import Footer from "@/layouts/partials/Footer.astro";
import publicAsset from "@/lib/utils/publicAsset";

interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
}

const {
  title = config.site.title,
  meta_title,
  description = config.metadata.meta_description,
  image,
} = Astro.props;

const pageTitle = meta_title || title;
const documentTitle = pageTitle === config.site.title
  ? config.site.title
  : `${pageTitle} · ${config.site.title}`;
const canonical = new URL(Astro.url.href);
canonical.search = "";
canonical.hash = "";
const canonicalUrl = canonical.href;
const socialPath = publicAsset(image)
  || publicAsset(config.metadata.meta_image)
  || config.site.favicon;
const socialImage = new URL(socialPath, config.site.base_url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={config.site.favicon} />
    <title>{documentTitle}</title>
    <meta name="author" content={config.metadata.meta_author} />
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Sujal Choudhari | Blog RSS" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Sujal Choudhari writing online" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Blog",
      name: config.site.title,
      url: config.site.base_url,
      description: config.metadata.meta_description,
      author: {
        "@type": "Person",
        name: config.metadata.meta_author,
        url: "https://sujal.xyz/",
        sameAs: [
          "https://github.com/SujalChoudhari",
          "https://linkedin.com/in/sujalchoudhari",
          "https://art.sujal.xyz/",
          "https://fs.sujal.xyz/",
        ],
      },
    })} />
    <style is:global>
      :root {
        color-scheme: light;
        --paper: #f7f4ee;
        --paper-raised: #fffdf8;
        --ink: #211f1b;
        --muted: #716d65;
        --rule: #d9d3c9;
        --accent: #9b4f32;
        --accent-dark: #773a26;
        --serif: ui-serif, Georgia, Cambria, "Times New Roman", serif;
        --sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        background: var(--paper);
      }

      body {
        min-width: 320px;
        margin: 0;
        overflow-x: hidden;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.65;
      }

      a {
        color: inherit;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      a:hover {
        color: var(--accent-dark);
      }

      a:focus-visible,
      button:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }

      main {
        width: 100%;
      }

      .site-main {
        min-height: 65vh;
      }

      .container {
        width: min(calc(100% - 2rem), 960px);
        margin-inline: auto;
      }

      .reading-width {
        width: min(calc(100% - 2rem), 720px);
        margin-inline: auto;
      }

      .section {
        padding-block: clamp(2.5rem, 6vw, 4.5rem);
      }

      h1,
      h2,
      h3,
      h4 {
        margin-top: 0;
        color: var(--ink);
        font-family: var(--serif);
        font-weight: 500;
        letter-spacing: -0.025em;
        line-height: 1.15;
      }

      h1 {
        margin-bottom: 1rem;
        font-size: clamp(2.35rem, 6vw, 4.2rem);
      }

      h2 {
        margin-bottom: 1rem;
        font-size: clamp(1.65rem, 3vw, 2.35rem);
      }

      h3 {
        margin-bottom: 0.65rem;
        font-size: clamp(1.25rem, 2vw, 1.65rem);
      }

      p {
        max-width: 72ch;
        margin: 0 0 1.25rem;
      }

      .skip-link {
        position: fixed;
        z-index: 10;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.7rem 1rem;
        transform: translateY(-180%);
        background: var(--ink);
        color: var(--paper-raised);
        font-weight: 700;
        text-decoration: none;
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      .site-header {
        width: min(calc(100% - 2rem), 960px);
        margin-inline: auto;
        padding-block: 1.35rem;
        border-bottom: 1px solid var(--rule);
      }

      .site-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem 2rem;
      }

      .site-title {
        flex: 0 0 auto;
        color: var(--ink);
        font-family: var(--serif);
        font-size: 1.35rem;
        line-height: 1.2;
        text-decoration: none;
      }

      .site-title:hover {
        color: var(--accent-dark);
      }

      .site-nav-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.15rem 0.85rem;
      }

      .site-nav-links a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        color: var(--muted);
        font-size: 0.88rem;
        text-decoration: none;
      }

      .site-nav-links a:hover,
      .site-nav-links a[aria-current="page"] {
        color: var(--accent-dark);
      }

      .site-nav-links a[aria-current="page"] {
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.35rem;
      }

      .site-footer {
        width: min(calc(100% - 2rem), 960px);
        margin-inline: auto;
        padding-block: 1.75rem 2.25rem;
        border-top: 1px solid var(--rule);
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem 2rem;
        color: var(--muted);
        font-size: 0.82rem;
      }

      .site-footer p {
        margin: 0;
      }

      .site-footer a {
        color: inherit;
      }

      .content {
        color: #302d28;
        font-family: var(--serif);
        font-size: clamp(1.08rem, 1.25vw, 1.18rem);
        line-height: 1.82;
      }

      .content > * {
        max-width: 72ch;
      }

      .content h2 {
        margin-top: 2.8rem;
        font-size: clamp(1.55rem, 3vw, 2.1rem);
      }

      .content h3 {
        margin-top: 2.25rem;
        font-size: clamp(1.25rem, 2vw, 1.65rem);
      }

      .content a {
        color: var(--accent-dark);
      }

      .content strong {
        color: var(--ink);
      }

      .content blockquote {
        margin: 2rem 0;
        padding: 0.25rem 0 0.25rem 1.25rem;
        border-left: 2px solid var(--accent);
        color: var(--muted);
        font-style: italic;
      }

      .content pre {
        max-width: 100%;
        margin: 1.75rem 0;
        padding: 1rem;
        overflow-x: auto;
        border: 1px solid var(--rule);
        border-radius: 0;
        background: #eeebe4;
        color: #292722;
        font-family: var(--mono);
        font-size: 0.82rem;
        line-height: 1.6;
        tab-size: 2;
        white-space: pre;
      }

      .content code {
        font-family: var(--mono);
        font-size: 0.86em;
        overflow-wrap: anywhere;
      }

      .content :not(pre) > code {
        padding: 0.08em 0.28em;
        background: #e9e5dd;
      }

      .content ul,
      .content ol {
        max-width: 68ch;
        padding-left: 1.4rem;
      }

      .content li {
        margin-bottom: 0.4rem;
      }

      .content img {
        display: none !important;
      }

      .content hr {
        margin: 2.5rem 0;
        border: 0;
        border-top: 1px solid var(--rule);
      }

      .post-list {
        margin: 0;
        padding: 0;
        border-top: 1px solid var(--rule);
        list-style: none;
      }

      .post-list-item {
        display: grid;
        grid-template-columns: minmax(7.5rem, 9.5rem) minmax(0, 1fr);
        gap: 1.25rem;
        padding: 1rem 0;
        border-bottom: 1px solid var(--rule);
      }

      .post-list-item .meta-line {
        color: var(--muted);
        font-size: 0.82rem;
        font-variant-numeric: tabular-nums;
        line-height: 1.5;
      }

      .post-list-item .title-line a {
        color: var(--ink);
        font-family: var(--serif);
        font-size: 1.2rem;
        text-decoration: none;
      }

      .post-list-item .title-line a:hover {
        color: var(--accent-dark);
        text-decoration: underline;
      }

      .post-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.35rem 0.6rem;
        margin: 0;
        color: var(--muted);
        font-size: 0.86rem;
        line-height: 1.6;
      }

      .post-meta a {
        color: inherit;
      }

      .tag-list {
        display: inline;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .tag-list li {
        display: inline;
        margin: 0;
      }

      .tag-list li:not(:last-child)::after {
        content: ", ";
      }

      .tag-list a {
        color: var(--muted);
      }

      @media (max-width: 640px) {
        .site-nav {
          align-items: flex-start;
          flex-direction: column;
          gap: 0.6rem;
        }

        .site-nav-links {
          justify-content: flex-start;
          gap: 0.15rem 1rem;
        }

        .site-footer {
          align-items: flex-start;
          flex-direction: column;
        }

        .post-list-item {
          grid-template-columns: 1fr;
          gap: 0.3rem;
        }

        .content {
          font-size: 1.08rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
        }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
