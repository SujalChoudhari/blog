---
import config from "@/config/config.json";
import Header from "@/layouts/partials/Header.astro";
import Footer from "@/layouts/partials/Footer.astro";
interface Props {
  title?: string;
  description?: string;
}

const { title = config.site.title, description = "" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title ? `${title} · ${config.site.title}` : config.site.title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.url.href} />
    <style is:global>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; font-family: "Inter", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 15px; line-height: 1.6; color: #000; background: #fff; }
      body { border-top: 4px solid #000; }
      main { width: 100%; max-width: 760px; margin: 0 auto; padding: 2rem 1rem; }
      a { color: #000; text-decoration: underline; text-underline-offset: 4px; }
      a:hover { text-decoration: none; background: #000; color: #fff; }
      .container { max-width: 760px; margin: 0 auto; padding: 0; }
      .section { padding-top: 1rem; padding-bottom: 2rem; }
      h1, h2, h3 { line-height: 1.25; letter-spacing: -0.02em; font-weight: 700; }
      h1 { font-size: 1.75rem; margin: 0 0 1rem; }
      h2 { font-size: 1.25rem; margin: 1.5rem 0 0.5rem; }
      h3 { font-size: 1.1rem; margin: 1.25rem 0 0.5rem; }
      p { max-width: 75ch; margin-top: 0; margin-bottom: 1.25rem; }
      pre, code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.9em; }
      pre { background: #fafafa; padding: 1rem; border: 1px solid #eaeaea; overflow: auto; border-radius: 6px; }
      blockquote { margin: 1.5rem 0; padding-left: 1rem; border-left: 2px solid #000; color: #333; }
      ul { padding-left: 1.5rem; margin-top: 0; margin-bottom: 1.25rem; }
      li { margin-bottom: 0.25rem; }
      .post-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid #eaeaea; }
      .post-list-item { padding: 0.75rem 0; border-bottom: 1px solid #eaeaea; display: flex; flex-direction: column; gap: 0.25rem; }
      @media (min-width: 600px) {
        .post-list-item { flex-direction: row; align-items: baseline; gap: 1.5rem; }
      }
      .post-list-item .meta-line { white-space: nowrap; color: #666; font-size: 0.85rem; font-variant-numeric: tabular-nums; }
      .post-list-item .title-line a { font-weight: 500; text-decoration: none; }
      .post-list-item .title-line a:hover { text-decoration: underline; background: transparent; color: #000; }
      .post-meta { color: #666; font-size: 0.85rem; margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
      .tag-list { padding: 0; margin: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .tag-list li { display: block; margin: 0; }
      .tag-list a { text-decoration: none; background: #f4f4f5; color: #000; padding: 0.15rem 0.5rem; font-size: 0.75rem; border-radius: 9999px; font-weight: 500; }
      .tag-list a:hover { background: #000; color: #fff; text-decoration: none; }
      .site-header { max-width: 760px; margin: 0 auto; padding: 1.5rem 1rem; border-bottom: 1px solid #eaeaea; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
      .site-title { font-weight: 700; font-size: 1.1rem; text-decoration: none; }
      .site-title:hover { background: transparent; color: #000; text-decoration: none; }
      .site-nav { display: flex; gap: 1.25rem; }
      .site-nav a { text-decoration: none; font-size: 0.9rem; color: #666; }
      .site-nav a:hover { color: #000; background: transparent; text-decoration: none; }
      .site-footer { max-width: 760px; margin: 0 auto; padding: 2rem 1rem; color: #666; font-size: 0.85rem; border-top: 1px solid #eaeaea; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
      .site-footer a { color: #666; text-decoration: none; }
      .site-footer a:hover { color: #000; background: transparent; text-decoration: underline; }
      .social-icons-simple { display: flex; gap: 1rem; list-style: none; padding: 0; margin: 1rem 0; flex-wrap: wrap; }
      .content img { display: none !important; } /* Hide all markdown images in posts */
    </style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
