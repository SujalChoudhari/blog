---
import config from "@/config/config.json";
import menu from "@/config/menu.json";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const normalizePath = (url: string) => {
  if (!url.startsWith("/")) return "";
  return url.replace(/\/+$/, "") || "/";
};
---

<header class="site-header" aria-label="Site header">
  <nav class="site-nav" aria-label="Primary navigation">
    <a
      href="/"
      class="site-title"
      aria-current={currentPath === "/" ? "page" : undefined}
    >{config.site.logo_text || config.site.title}</a>
    <span class="site-nav-links">
      {menu.main.filter((item) => item.url !== "/").map((item) => (
        <a
          href={item.url}
          aria-current={normalizePath(item.url) === currentPath ? "page" : undefined}
        >
          {item.name}
        </a>
      ))}
      <button
        type="button"
        class="search-trigger-btn"
        data-open-search
        aria-label="Search posts (Cmd+K)"
        title="Search posts (Cmd+K)"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-trigger-text">Search</span>
        <kbd class="header-kbd">⌘K</kbd>
      </button>
    </span>
  </nav>
</header>
