---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
---

<header class="site-header">
  <div>
    <a href="/" class="site-title">{config.site.logo_text || config.site.title}</a>
  </div>
  <nav class="site-nav">
    {menu.main.map((item) => (
      <a href={item.url}>{item.name}</a>
    ))}
  </nav>
</header>
